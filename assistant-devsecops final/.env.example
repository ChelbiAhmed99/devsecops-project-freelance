# Copier ce fichier en .env puis l'adapter. Le fichier .env ne doit JAMAIS être commité ni partagé.

# --- Sécurité (OBLIGATOIRE) ---
# Secret de signature des jetons JWT, 32 caractères minimum. Générer : openssl rand -base64 48
JWT_SECRET=
# Clé du pipeline CI/CD (en-tête X-API-Key sur /api/ci/**). Vide = intégration CI désactivée.
# Générer : openssl rand -hex 24
CI_API_KEY=
# Mots de passe des trois comptes créés au premier démarrage (base vide uniquement)
BOOTSTRAP_ADMIN_PASSWORD=Admin@2026
BOOTSTRAP_QUALITY_PASSWORD=Qualite@2026
BOOTSTRAP_DEVELOPER_PASSWORD=Dev@2026

# --- Base de données ---
DB_USERNAME=assistant
DB_PASSWORD=assistant

# --- IA (optionnel : sans clé, le moteur heuristique local répond à la place) ---
GROQ_API_KEY=
ASSISTANT_AI_MODEL=openai/gpt-oss-120b

# --- Scans de sécurité ---
# Clé gratuite (https://nvd.nist.gov/developers/request-an-api-key) : sans elle, le premier
# scan OWASP met 20 à 60 minutes à télécharger la base des vulnérabilités.
NVD_API_KEY=
SONAR_ENABLED=false
SONAR_TOKEN=
# GID du socket Docker pour que Trivy scanne les images locales.
#   Linux : getent group docker | cut -d: -f3        Docker Desktop (Windows/macOS) : 0
DOCKER_GID=999

# --- Observabilité ---
LOKI_ENABLED=false
GRAFANA_PASSWORD=admin

# --- Divers ---
# Fuseau horaire des dates affichées
TZ=Africa/Tunis
# Données d'exemple au premier démarrage (logs, vulnérabilités, 3 exécutions de tests)
ASSISTANT_DEMO_ENABLED=true
IMAGE_TAG=latest
