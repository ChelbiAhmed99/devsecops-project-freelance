// Pipeline Jenkins déclaratif équivalent (credentials : assistant-api-key, nvd-api-key).
pipeline {
  agent any
  environment {
    ASSISTANT_URL = 'http://assistant.local:8080'
    ASSISTANT_API_KEY = credentials('assistant-api-key')
  }
  stages {
    stage('Tests backend') {
      steps { dir('backend') { sh 'mvn -B verify' } }
      post { always { junit 'backend/target/surefire-reports/*.xml' } }
    }
    stage('Tests IA') {
      steps { dir('ia-service') { sh 'pip install -q -r requirements-dev.txt && pytest -q' } }
    }
    stage('Build frontend') {
      steps { dir('frontend') { sh 'npm ci && npm test && npm run build' } }
    }
    stage('OWASP Dependency-Check') {
      steps { dir('backend') { sh 'mvn -B org.owasp:dependency-check-maven:check -Dformat=JSON || true' } }
    }
    stage('Image + Trivy') {
      steps {
        sh 'docker build -t assistant-devsecops-backend:${BUILD_NUMBER} backend'
        sh 'trivy image --format json --quiet assistant-devsecops-backend:${BUILD_NUMBER} > trivy-report.json || true'
      }
    }
    stage('Publication + quality gate') {
      steps {
        sh 'BRANCH=${BRANCH_NAME} COMMIT_SHA=${GIT_COMMIT} PIPELINE_ID=${BUILD_NUMBER} ./scripts/ci/publish-results.sh'
      }
    }
  }
}
